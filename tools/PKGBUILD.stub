# THIS IS A *PARTIAL* PKGBUILD TEMPLATE FOR THE AUTOMATED RELEASE BUILD ONLY
pkgname="kholabangla-keyboard"
pkgrel=1
pkgdesc="Bangla (Avro Phonetic) input method for Linux"
arch=('x86_64' 'aarch64')
url="https://github.com/tasin-py/KholaBangla"
license=('GPL3')
depends=('qt5-base' 'qt5-svg' 'zstd')
optdepends=('ibus: IBus support' 'fcitx5: Fcitx5 support')
makedepends=('cmake' 'ninja' 'rust' 'libibus' 'fcitx5')
options=('!debug')
build() {
    cmake -S "$srcdir" -B "$srcdir/_build" -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DENABLE_BOTH=ON
    ninja -C "$srcdir/_build"
}
package() {
    DESTDIR="$pkgdir" ninja -C "$srcdir/_build" install
}
